# EXAMPLE ONLY. Set real values in Supabase Edge Function Secrets, never in Git/chat.
# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# to hosted functions automatically. For local serving only, set those privately.
PORTAL_ORIGIN=https://dylanforsberg.com
PORTAL_EXTRA_ORIGINS=
STRIPE_SECRET_KEY=sk_test_REPLACE_IN_PRIVATE_PROVIDER_SETTINGS
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_IN_PRIVATE_PROVIDER_SETTINGS
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_IN_PRIVATE_PROVIDER_SETTINGS
STRIPE_PORTAL_CONFIGURATION_ID=bpc_REPLACE_WITH_TEST_CONFIGURATION_ID
ADMIN_NOTIFICATION_EMAIL=Dylan.Forsberg@gmail.com
# Generate a long random value in a password manager; also store it in Supabase Vault.
PORTAL_JOB_SECRET=REPLACE_WITH_RANDOM_PRIVATE_JOB_SECRET
CANCELLATION_POLICY=review
CANCELLATION_POLICY_REVIEWED=false
RENEWAL_REMINDERS_ENABLED=false
RENEWAL_REMINDER_DAYS=45
# Optional notification transport; configure SMTP for Auth emails separately.
RESEND_API_KEY=
NOTIFICATION_FROM=
